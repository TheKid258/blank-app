# Copie para .streamlit/secrets.toml (local) ou cole em Settings > Secrets (Streamlit Cloud)

INSTAGRAM_USER = "seu_usuario"

# Link compartilhado da pasta ou do .zip no Dropbox (só aparece depois da verificação)
DROPBOX_DOWNLOAD_URL = "https://www.dropbox.com/scl/fo/XXXX/pasta?dl=1"

# Links compartilhados de cada faixa (usados só para ouvir)
[[TRACKS]]
title = "Música 1"
url = "https://www.dropbox.com/scl/fi/XXXX/musica1.mp3?rlkey=XXXX&dl=0"

[[TRACKS]]
title = "Música 2"
url = "https://www.dropbox.com/scl/fi/YYYY/musica2.mp3?rlkey=YYYY&dl=0"
